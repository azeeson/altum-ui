{
	"name": "altum",
	"version": "0.0.4",
	"description": "Библиотека React + TypeScript UI-компонентов: CSS Modules, токены ThemeProvider, адаптация overlay/sheet.",
	"license": "MIT",
	"author": "Alexander <azeeson@gmail.com>",
	"keywords": [
		"react",
		"components",
		"typescript",
		"ui",
		"design-system",
		"css-modules"
	],
	"engines": {
		"node": ">=18"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./hooks": {
			"types": "./types/entries/hooks.d.ts",
			"import": "./dist/entries/hooks.js",
			"default": "./dist/entries/hooks.js"
		},
		"./utils": {
			"types": "./types/entries/utils.d.ts",
			"import": "./dist/entries/utils.js",
			"default": "./dist/entries/utils.js"
		},
		"./icons": {
			"types": "./types/entries/icons.d.ts",
			"import": "./dist/entries/icons.js",
			"default": "./dist/entries/icons.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"types",
		"docs",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"start": "npm run storybook",
		"typecheck": "tsc -p tsconfig.types.json --noEmit",
		"build": "rollup -c rollup.config.mjs && node scripts/bundle-types.mjs && node scripts/cleanup-declaration-artifacts.mjs",
		"prepublishOnly": "npm run lint && npm run lint:css && npm run lint:css-ownership && npm run typecheck && npm run build && npm run pack:check",
		"pack:check": "node scripts/pack-check.mjs",
		"release": "npm test && npm publish",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build -o dist-storybook",
		"test": "npm run build-storybook && playwright test",
		"test:visual": "npm run build-storybook && playwright test tests/visual",
		"test:behavior": "npm run build-storybook && playwright test tests/behavior",
		"test:update-snapshots": "npm run build-storybook && playwright test --update-snapshots",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:css": "stylelint \"src/**/*.css\"",
		"lint:css:fix": "stylelint \"src/**/*.css\" --fix && node scripts/fix-css-brace-format.mjs && stylelint \"src/**/*.css\" --fix",
		"lint:css-ownership": "node scripts/audit-css-ownership.mjs",
		"scaffold": "node scripts/scaffold-component.mjs"
	},
	"browserslist": [
		"chrome >= 100",
		"firefox >= 100",
		"safari >= 16",
		"not dead"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"**/*.module.css.js"
	],
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.51.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@storybook/addon-essentials": "^7.0.22",
		"@storybook/react": "^7.0.22",
		"@storybook/react-webpack5": "^7.0.22",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-plugin": "^5.2.1",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"autoprefixer": "^10.5.4",
		"css-loader": "^6.8.1",
		"esbuild": "^0.25.9",
		"eslint": "^9.39.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"http-server": "^14.1.1",
		"postcss": "^8.5.24",
		"postcss-nesting": "^14.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"rollup": "^4.62.2",
		"rollup-plugin-dts": "^6.4.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-postcss": "^4.0.2",
		"storybook": "^7.0.22",
		"style-loader": "^3.3.3",
		"stylelint": "^17.14.1",
		"stylelint-order": "^8.1.1",
		"ts-loader": "^9.4.3",
		"typescript": "^5.1.3",
		"typescript-eslint": "^8.62.1",
		"webpack": "^5.109.2"
	},
	"overrides": {
		"webpack": "^5.109.2"
	}
}
